<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/html_dream_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/html_dream_label"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/html_dream_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/html_dream_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/html_dream_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints=""
            android:hint="@string/html_dream_url_hint"
            android:inputType="textUri"
            android:maxLines="3" />

        <Button
            android:id="@+id/html_dream_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/html_dream_pick" />

        <Button
            android:id="@+id/html_dream_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/html_dream_reset" />

        <CheckBox
            android:id="@+id/html_dream_interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/html_dream_interactive" />

        <Button
            android:id="@+id/html_dream_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/html_dream_save" />
    </LinearLayout>
</ScrollView>
