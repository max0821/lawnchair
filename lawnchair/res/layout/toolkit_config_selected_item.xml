<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the "selected" list: shows its position and can be dragged to reorder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/toolkit_selected_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="22dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/toolkit_selected_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/toolkit_selected_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/toolkit_selected_remove"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_close" />

    <ImageView
        android:id="@+id/toolkit_selected_handle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null"
        android:padding="7dp"
        android:src="@drawable/ic_toolkit_drag" />
</LinearLayout>
