<?xml version="1.0" encoding="utf-8"?>
<!--
     Root container of the toolkit widget. Rows are added at runtime so the widget
     can adapt to whatever height the user resized it to.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/toolkit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/toolkit_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="@string/toolkit_empty_hint"
        android:textColor="@android:color/white"
        android:textSize="13sp" />
</FrameLayout>
